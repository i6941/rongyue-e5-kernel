From 85f09691e93de4818667ad290eff6a586996bd89 Mon Sep 17 00:00:00 2001
From: E5 Developer <dev@e5.local>
Date: Sun, 25 Oct 2026 07:46:13 +0800
Subject: [PATCH 1/7] build: fix include paths for trusty and modem power
 manager

---
 drivers/trusty/Makefile                              | 1 +
 drivers/unisoc_platform/modem/power_manager/Makefile | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/trusty/Makefile b/drivers/trusty/Makefile
index 2f5b445b7..b7123fbae 100644
--- a/drivers/trusty/Makefile
+++ b/drivers/trusty/Makefile
@@ -15,3 +15,4 @@ obj-$(CONFIG_TRUSTY_VIRTIO) += trusty-virtio.o
 obj-$(CONFIG_TRUSTY_VIRTIO_IPC) += trusty-ipc.o
 obj-$(CONFIG_SPRD_TSHM) += sprd_shm.o
 obj-$(CONFIG_TRUSTY_TUI) += trusty-tui.o
+ccflags-y += -I$(src)
diff --git a/drivers/unisoc_platform/modem/power_manager/Makefile b/drivers/unisoc_platform/modem/power_manager/Makefile
index 2d99a9662..bd1dfacd2 100644
--- a/drivers/unisoc_platform/modem/power_manager/Makefile
+++ b/drivers/unisoc_platform/modem/power_manager/Makefile
@@ -1,2 +1,3 @@
 
 obj-$(CONFIG_UNISOC_MODEM_POWER_MANAGER)	+= sprd_power_manager.o
+ccflags-y += -I$(src)
